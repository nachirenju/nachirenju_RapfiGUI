{
  "name": "RapfiGUI",
  "version": "1.0.0",
  "author": "nachirenju",
  "description": "Rapfi GUI Application",
  "main": "loader.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "bytenode": "^1.5.7",
    "wasm-feature-detect": "^1.8.0"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "vite": "^8.0.13"
  },
  "build": {
    "appId": "com.rapfi.gui",
    "productName": "Rapfi GUI",
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!engine/**/*",
      "!main.js",
      "!preload.js",
      "!build-bytecode.js"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine"
      }
    ]
  }
}
